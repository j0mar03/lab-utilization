APP_NAME="Lab Utilization System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (Docker service name = db) ──────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lab_utilization
DB_USERNAME=lab_user
DB_PASSWORD=lab_password

# ── Cache / Sessions / Queues ─────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_STORE=database
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ── Mail (disabled for local dev) ─────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@lab.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Telegram Bot ──────────────────────────────────────────────────────────
# Fill these in to enable Telegram notifications.
# Leave blank to disable (system still works; notifications just silently skip).
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ── Google Form API ───────────────────────────────────────────────────────
# Paste the same value into Apps Script → Script Properties → LARAVEL_API_KEY
API_SECRET_KEY=

# ── QR Code package ──────────────────────────────────────────────────────
QRCODE_FORMAT=svg
