APP_NAME="Lab Utilization System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── Database (Connects to existing facultyportfolio-db) ──────────────────────
DB_CONNECTION=mysql
DB_HOST=facultyportfolio-db
DB_PORT=3306
DB_DATABASE=lab_utilization
DB_USERNAME=lab_user
DB_PASSWORD=LabSystem2026!Secure

# ── Cache / Sessions / Queues ────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_STORE=database
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@lab.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Telegram Bot Notifications ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="8375004820:AAFEqfIxsR5gqbthXSrq6_-76ZpB57nCF_M"
